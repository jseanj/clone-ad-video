      "action": {
        "producer": "render-html",
        "frames": 30,
        "config": {
          "width": 1080,
          "height": 1920,
          "fps": 30,
          "crf": 20,
          "preset": "fast",
          "transparent": false,
          "timeout_seconds": 30
        }
      },
      "inputs": {
        "html": {
          "kind": "file",
          "path": "hook_card.html",
          "type": "html"
        }
      }
    },
