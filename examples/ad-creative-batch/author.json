      "inputs": {
        "script": {
          "kind": "script",
          "path": "script.svml",
          "view": "speech"
        },
        "layout": {
          "kind": "file",
          "path": "layout.json",
          "type": "project"
        },
        "voice:hook": {
          "kind": "output",
          "output": "voice-hook.audio"
        },
        "voice:context": {
          "kind": "output",
          "output": "voice-context.audio"
        },
        "voice:payoff": {
          "kind": "output",
          "output": "voice-payoff.audio"
        },
        "voice:proof": {
          "kind": "output",
          "output": "voice-proof.audio"
        },
        "voice:outro": {
          "kind": "output",
          "output": "voice-outro.audio"
        }
      }
    },
    {
      "id": "mix",
      "action": {
        "producer": "mix"
      },
      "inputs": {
        "script": {
          "kind": "script",
          "path": "script.svml",
          "view": "speech"
        },
        "project": {
          "kind": "output",
          "output": "align.project"
        },
        "voice:hook": {
          "kind": "output",
          "output": "voice-hook.audio"
        },
        "voice:context": {
          "kind": "output",
          "output": "voice-context.audio"
        },
        "voice:payoff": {
          "kind": "output",
          "output": "voice-payoff.audio"
        },
        "voice:proof": {
          "kind": "output",
          "output": "voice-proof.audio"
        },
        "voice:outro": {
          "kind": "output",
          "output": "voice-outro.audio"
        }
      }
    },
    {
